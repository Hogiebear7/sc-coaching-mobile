{
  "expo": {
    "name": "S&C Performance Coaching",
    "slug": "sc-coaching-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sccoachingmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sandcperformancecoaching.app",
      "infoPlist": {
        "CFBundleDisplayName": "S&C Performance",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "buildNumber": "16"
    },
    "android": {
      "package": "com.sandcperformancecoaching.app",
      "versionCode": 104,
      "adaptiveIcon": {
        "backgroundColor": "#0a1526",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_PROMOTED_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withFixedLauncherIcons.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a1526",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 500
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "S&C Coaching uses the camera to scan barcodes and nutrition labels when logging food.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "S&C Coaching uses your photo library to set a profile picture and to identify food from an uploaded photo or screenshot.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "S&C Coaching uses your location to find nearby gyms and coaches."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": false
        }
      ],
      "./plugins/withTransparentSplashIcon.js",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Teko",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/teko/600SemiBold/Teko_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/teko/700Bold/Teko_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/teko/600SemiBold/Teko_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/teko/700Bold/Teko_700Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "WaterWidget",
              "displayName": "Water",
              "description": "Today's water, and a button to add your usual amount.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ]
              }
            },
            {
              "name": "NutritionWidget",
              "displayName": "Nutrition",
              "description": "Calories and protein today, against your targets.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            },
            {
              "name": "ClassWidget",
              "displayName": "Next class",
              "description": "Your next booked class, and classes left on your plan.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Water",
              "label": "Water",
              "description": "Today's water, and a button to add your usual amount.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/water.png"
            },
            {
              "name": "Nutrition",
              "label": "Nutrition",
              "description": "Calories and protein today, against your targets.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/nutrition.png"
            },
            {
              "name": "NextClass",
              "label": "Next class",
              "description": "Your next booked class, and classes left on your plan.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/next-class.png"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e91de324-82a4-437a-9344-1b8a89102f72"
      }
    },
    "owner": "sandcmails-team"
  }
}
