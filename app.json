{
  "expo": {
    "name": "S&C Performance Coaching",
    "slug": "sc-coaching-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sccoachingmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sandcperformancecoaching.app",
      "infoPlist": {
        "CFBundleDisplayName": "S&C Performance"
      }
    },
    "android": {
      "package": "com.sandcperformancecoaching.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a1526",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a1526",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "S&C Coaching uses the camera to scan barcodes and nutrition labels when logging food.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "S&C Coaching uses your photo library to set a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e86493d0-d47c-4001-a120-ca3608eb3fde"
      }
    }
  }
}
